# ---- Required ----

# Postgres connection string.
# In production use a POOLED connection string (e.g. Neon's `-pooler` host) —
# the app keeps one connection per serverless instance and fans in via the pooler.
DATABASE_URL=

# Session-signing secret. Generate one with:  openssl rand -base64 32
# Must be at least 16 characters.
AUTH_SECRET=

# ---- First-admin bootstrap (only read by `npm run db:create-admin`) ----
# Creates/resets a single admin so you can sign in on a fresh database.
# Everyone else is invited from /admin/users afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- OAuth 2.1 for the MCP server (optional) ----

# The canonical public origin, e.g. https://creative.urjwan.com — used as the
# OAuth `issuer` and to build every URL in the discovery documents. Leave it
# empty and the app uses the request's own host, which is what makes localhost
# and Vercel previews work with no configuration. Set it in production so the
# issuer is stable no matter which host a request arrives on.
APP_ORIGIN=

# ---- Creative thumbnails (Vercel Blob) ----

# Read/write token for the Blob store that holds creative thumbnails.
# Vercel adds it automatically once a Blob store is connected to the project;
# copy it here for local development. Without it, POST /api/uploads/thumbnail
# returns 503 and the rest of the app works normally.
BLOB_READ_WRITE_TOKEN=

# Note: Google OAuth and Vercel KV are NOT wired up — auth is email + password
# and upload-validation sessions live in Postgres. Re-add those vars here
# if/when those integrations are implemented.
